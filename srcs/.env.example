# =============================================================================
# Environment configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Never commit .env to version control (add it to .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Generate strong secrets with: openssl rand -hex 16
# Avoid special characters like $, #, quotes, or spaces unless you quote the
# value, since they can be misparsed by Docker Compose and shells.

# Database name created on first start
DB_NAME=wordpress

# Database user (use a dedicated user, not root)
DB_USER=wp_user

# Database password (required)
DB_PASSWORD=

# Hostname of the database service. Must match the service name in
# docker-compose.yml. Leave as-is unless you renamed the service.
DB_HOST=database

# -----------------------------------------------------------------------------
# WordPress site
# -----------------------------------------------------------------------------
WORDPRESS_SITE_TITLE="Hello Inception"

# -----------------------------------------------------------------------------
# WordPress admin account (full administrator rights)
# -----------------------------------------------------------------------------
# Avoid obvious usernames like "admin".
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_EMAIL=admin@example.com
# Generate with: openssl rand -base64 24
WORDPRESS_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# WordPress default user (secondary account, e.g. an editor or author)
# -----------------------------------------------------------------------------
WORDPRESS_USER=
WORDPRESS_EMAIL=user@example.com
# Generate with: openssl rand -base64 24
WORDPRESS_PASSWORD=