# =============================================================================
# Environment configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Never commit .env to version control (add it to .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Generate strong secrets with: openssl rand -hex 16
# Avoid special characters like $, #, quotes, or spaces unless you quote the
# value, since they can be misparsed by Docker Compose and shells.

# Database name created on first start
DB_NAME=wordpress

# Database user (use a dedicated user, not root)
DB_USER=wp_user

# Database password (required)
DB_PASSWORD=

# Hostname of the database service. Must match the service name in
# docker-compose.yml. Leave as-is unless you renamed the service.
DB_HOST=database

# -----------------------------------------------------------------------------
# WordPress site
# -----------------------------------------------------------------------------
WORDPRESS_SITE_TITLE="Hello Inception"

# -----------------------------------------------------------------------------
# WordPress admin account (full administrator rights)
# -----------------------------------------------------------------------------
# Avoid obvious usernames like "admin".
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_EMAIL=admin@example.com
# Generate with: openssl rand -base64 24
WORDPRESS_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# WordPress default user (secondary account, e.g. an editor or author)
# -----------------------------------------------------------------------------
WORDPRESS_USER=
WORDPRESS_EMAIL=user@example.com
# Generate with: openssl rand -base64 24
WORDPRESS_PASSWORD=

# -----------------------------------------------------------------------------
# WordPress default post
# Created once, on first install only (skipped if a post with this title exists)
# -----------------------------------------------------------------------------
WORDPRESS_DEFAULT_POST_TITLE="Welcome to Inception"
WORDPRESS_DEFAULT_POST_CONTENT="This site runs on NGINX, WordPress/php-fpm and MariaDB, each in its own container."
WORDPRESS_DEFAULT_POST_STATUS=publish        # publish | draft | private
WORDPRESS_DEFAULT_POST_AUTHOR=               # login of an existing user, e.g. ${WORDPRESS_ADMIN_USER}

# -----------------------------------------------------------------------------
# Redis (object cache for WordPress)
# -----------------------------------------------------------------------------
# Hostname = Docker service name on the inception network
WORDPRESS_REDIS_HOST=redis
WORDPRESS_REDIS_PORT=6379
# Generate with: openssl rand -base64 24
WORDPRESS_REDIS_PASSWORD=
# Redis has 16 databases (0-15). Use 0 unless several sites share the instance
WORDPRESS_REDIS_DATABASE=0
# Prefix for all cache keys, avoids collisions if several sites share Redis
WORDPRESS_REDIS_PREFIX=wp_inception_
# Timeouts in seconds
WORDPRESS_REDIS_TIMEOUT=1
WORDPRESS_REDIS_READ_TIMEOUT=1

# -----------------------------------------------------------------------------
# FTP server (vsftpd)
# -----------------------------------------------------------------------------
# Account used to upload files into the WordPress volume.
# Use a dedicated username, not the WordPress admin one.
FTP_USER=
# Generate with: openssl rand -base64 24
FTP_PASSWORD=